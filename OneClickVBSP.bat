function Invoke-VBSPBoot {
    param([string]$payload)
    
    # [1] Anti-Debugging Check
    if ([System.Diagnostics.Debugger]::IsAttached) { exit }
    
    # [2] Mathematical Anti-Tamper: Bind Key to Function Integrity
    # Any alteration to this loader function produces a radically different hash,
    # corrupting the AES key and failing decryption with zero code leakage.
    $sbText = ($MyInvocation.MyCommand.ScriptBlock.ToString() -replace "`r", "").Trim()
    $sbBytes = [System.Text.Encoding]::UTF8.GetBytes($sbText)
    $integrityHash = [System.Security.Cryptography.SHA256]::Create().ComputeHash($sbBytes)
    
    # [3] Obfuscated Dynamic Key Derivation
    # Masked seed with author signature transformations (Giap Hai - VBSP Bac Ninh)
    $maskedSeed = [byte[]]@(
        0x37, 0x26, 0x37, 0x34, 0x56, 0x54, 0x56, 0x52,
        0x23, 0x0D, 0x05, 0x14, 0x20, 0x11, 0x07, 0x2C,
        0x0C, 0x05, 0x2D, 0x05, 0x07, 0x2A, 0x0D, 0x0A,
        0x0C, 0x27, 0x2A, 0x30, 0x30, 0x5C, 0x5C, 0x5D
    )
    $derivedKeyMaterial = New-Object byte[] 32
    for ($i = 0; $i -lt 32; $i++) {
        $derivedKeyMaterial[$i] = [byte](($maskedSeed[$i] -bxor 0x64) -bxor $integrityHash[$i])
    }
    $aesKey = [System.Security.Cryptography.SHA256]::Create().ComputeHash($derivedKeyMaterial)
    
    # [4] AES-256-CBC Decryption & Payload Extraction
    $allBytes = [Convert]::FromBase64String($payload)
    if ($allBytes.Length -le 16) { exit }
    
    $iv = New-Object byte[] 16
    [Array]::Copy($allBytes, 0, $iv, 0, 16)
    $cipherBytes = New-Object byte[] ($allBytes.Length - 16)
    [Array]::Copy($allBytes, 16, $cipherBytes, 0, $cipherBytes.Length)
    
    $aes = [System.Security.Cryptography.Aes]::Create()
    $aes.KeySize = 256
    $aes.BlockSize = 128
    $aes.Mode = [System.Security.Cryptography.CipherMode]::CBC
    $aes.Padding = [System.Security.Cryptography.PaddingMode]::PKCS7
    $aes.Key = $aesKey
    $aes.IV = $iv
    
    $decryptedGzip = $null
    $decompressedCode = $null
    try {
        $decryptor = $aes.CreateDecryptor()
        $decryptedGzip = $decryptor.TransformFinalBlock($cipherBytes, 0, $cipherBytes.Length)
        
        $mIn = New-Object System.IO.MemoryStream(,$decryptedGzip)
        $gz = New-Object System.IO.Compression.GZipStream($mIn, [System.IO.Compression.CompressionMode]::Decompress)
        $mOut = New-Object System.IO.MemoryStream
        $gz.CopyTo($mOut)
        $gz.Close()
        $mIn.Close()
        
        $decompressedCode = [System.Text.Encoding]::UTF8.GetString($mOut.ToArray())
        $mOut.Close()
    } catch {
        # Tampering detected, corrupted key, or failed verification
        exit
    } finally {
        # [5] In-Memory Secure Wiping
        [Array]::Clear($aesKey, 0, $aesKey.Length)
        [Array]::Clear($derivedKeyMaterial, 0, $derivedKeyMaterial.Length)
        [Array]::Clear($iv, 0, $iv.Length)
        [Array]::Clear($cipherBytes, 0, $cipherBytes.Length)
        if ($null -ne $decryptedGzip) { [Array]::Clear($decryptedGzip, 0, $decryptedGzip.Length) }
        $aes.Dispose()
    }
    
    if ([string]::IsNullOrEmpty($decompressedCode)) { exit }
    
    # [6] Execute Code in isolated scriptblock and collect garbage
    $sb = [scriptblock]::Create($decompressedCode)
    $decompressedCode = $null
    $payload = $null
    [System.GC]::Collect()
    
    . $sb
}

function Check-VBSPUpdate {
    param(
        [string]$currentVer = "v2026.10.08",
        [string]$repo = "giaphai/OneClickVBSP-Release",
        [string]$targetFile = $null
    )
    try {
        $rawUrl = "https://raw.githubusercontent.com/$repo/main/version.txt"
        $relUrl = "https://github.com/$repo/releases/latest"
        $latestVer = $null
        
        # 1. Kiem tra phien ban moi (timeout ket noi 2s, toi da 3s de khong lam tre khoi dong)
        if (Get-Command "curl.exe" -ErrorAction SilentlyContinue) {
            $res = & curl.exe -s --connect-timeout 2 --max-time 3 -L "$rawUrl" 2>$null
            if ($res -and $res -match '^v?\d{4}') {
                $latestVer = $res.Trim()
            }
            
            if ([string]::IsNullOrWhiteSpace($latestVer)) {
                $headers = & curl.exe -s -I --connect-timeout 2 --max-time 3 "$relUrl" 2>$null
                foreach ($h in $headers) {
                    if ($h -match 'location:\s*https://github\.com/[^/]+/[^/]+/releases/tag/([^\r\n\s]+)') {
                        $tag = $Matches[1].Trim()
                        if ($tag -match '^v?\d{4}') {
                            $latestVer = $tag
                            break
                        }
                    }
                }
            }
        }
        
        # Fallback qua WebClient neu curl khong kha dung
        if ([string]::IsNullOrWhiteSpace($latestVer)) {
            try {
                $wc = New-Object System.Net.WebClient
                $wc.Headers.Add("User-Agent", "OneClickVBSP-UpdateChecker")
                $task = $wc.DownloadStringTaskAsync($rawUrl)
                if ($task.Wait(2000)) {
                    $str = $task.Result.Trim()
                    if ($str -match '^v?\d{4}') { $latestVer = $str }
                }
                $wc.Dispose()
            } catch {}
        }
        
        # 2. Xac thuc phien ban hop le va so sanh
        if (-not [string]::IsNullOrWhiteSpace($latestVer) -and $latestVer -match '^v?\d{4}' -and $latestVer -ne $currentVer) {
            Add-Type -AssemblyName System.Windows.Forms -ErrorAction SilentlyContinue
            $title = "OneClickVBSP - C{0}p nh{0}t phi{1}n b{2}n m{3}i" -f [char]0x1EAD, [char]0x00EA, [char]0x1EA3, [char]0x1EDB
            $msg = ("H{0} th{1}ng ph{2}t hi{0}n phi{3}n b{4}n m{5}i tr{3}n GitHub:`n`n" -f [char]0x1EC7, [char]0x1ED1, [char]0x00E1, [char]0x00EA, [char]0x1EA3, [char]0x1EDB) +
                   ("  {0} Phi{1}n b{2}n hi{3}n t{4}i: $currentVer`n" -f [char]0x2022, [char]0x00EA, [char]0x1EA3, [char]0x1EC7, [char]0x1EA1) +
                   ("  {0} Phi{1}n b{2}n m{3}i nh{4}t: $latestVer`n`n" -f [char]0x2022, [char]0x00EA, [char]0x1EA3, [char]0x1EDB, [char]0x1EA5) +
                   ("B{0}n c{1} mu{2}n T{3} {4}{5}NG T{6}I V{7} V{8} C{9}P NH{9}T ngay kh{10}ng?" -f [char]0x1EA1, [char]0x00F3, [char]0x1ED1, [char]0x1EF0, [char]0x0110, [char]0x1ED8, [char]0x1EA2, [char]0x1EC0, [char]0x00C0, [char]0x1EAC, [char]0x00F4)
            $choice = [System.Windows.Forms.MessageBox]::Show($msg, $title, [System.Windows.Forms.MessageBoxButtons]::YesNo, [System.Windows.Forms.MessageBoxIcon]::Information)
            
            if ($choice -eq [System.Windows.Forms.DialogResult]::Yes) {
                $fileName = if ($targetFile) { Split-Path $targetFile -Leaf } else { "OneClickVBSP.bat" }
                if ($fileName -notmatch '\.(bat|ps1)$') { $fileName = "OneClickVBSP.bat" }
                
                $tempPath = "$targetFile.new"
                $dlSuccess = $false
                
                $dlReleaseUrl = "https://github.com/$repo/releases/latest/download/$fileName"
                $dlRawUrl     = "https://raw.githubusercontent.com/$repo/main/$fileName"
                
                foreach ($url in @($dlReleaseUrl, $dlRawUrl)) {
                    if (Get-Command "curl.exe" -ErrorAction SilentlyContinue) {
                        & curl.exe -s -L --connect-timeout 5 --max-time 60 -o "$tempPath" "$url" 2>$null
                        if ((Test-Path "$tempPath") -and (Get-Item "$tempPath").Length -gt 1000) {
                            $dlSuccess = $true
                            break
                        }
                    }
                    try {
                        $wc = New-Object System.Net.WebClient
                        $wc.Headers.Add("User-Agent", "OneClickVBSP-Updater")
                        $wc.DownloadFile($url, $tempPath)
                        $wc.Dispose()
                        if ((Test-Path "$tempPath") -and (Get-Item "$tempPath").Length -gt 1000) {
                            $dlSuccess = $true
                            break
                        }
                    } catch {}
                }
                
                if ($dlSuccess) {
                    $bakPath = "$targetFile.bak"
                    Copy-Item -Path $targetFile -Destination $bakPath -Force -ErrorAction SilentlyContinue
                    Move-Item -Path $tempPath -Destination $targetFile -Force
                    $successTitle = "C{0}p nh{0}t th{1}nh c{2}ng" -f [char]0x1EAD, [char]0x00E0, [char]0x00F4
                    $successMsg = ("{0}{1} c{2}p nh{2}t l{3}n phi{4}n b{5}n $latestVer th{6}nh c{7}ng!`n{8}ng d{9}ng s{10} t{11} {12}{13}ng kh{14}i {12}{13}ng l{15}i." -f [char]0x0110, [char]0x00E3, [char]0x1EAD, [char]0x00EA, [char]0x00EA, [char]0x1EA3, [char]0x00E0, [char]0x00F4, [char]0x1EE8, [char]0x1EE5, [char]0x1EBD, [char]0x1EF1, [char]0x0111, [char]0x1ED9, [char]0x1EDF, [char]0x1EA1)
                    [System.Windows.Forms.MessageBox]::Show($successMsg, $successTitle, [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information)
                    if ($targetFile -match '\.ps1$') {
                        Start-Process powershell.exe -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$targetFile`""
                    } else {
                        Start-Process cmd.exe -ArgumentList "/c `"$targetFile`""
                    }
                    exit
                } else {
                    if (Test-Path "$tempPath") { Remove-Item "$tempPath" -Force -ErrorAction SilentlyContinue }
                    $errTitle = "L{0}i t{1}i c{2}p nh{2}t" -f [char]0x1ED7, [char]0x1EA3, [char]0x1EAD
                    $errMsg = "Kh{0}ng th{1} t{2}i b{3}n c{4}p nh{4}t t{5} {6}{7}ng. {8}ang m{9} trang GitHub Releases {10}{11} t{2}i th{12} c{0}ng..." -f [char]0x00F4, [char]0x1EC3, [char]0x1EA3, [char]0x1EA3, [char]0x1EAD, [char]0x1EF1, [char]0x0111, [char]0x1ED9, [char]0x0110, [char]0x1EDF, [char]0x0111, [char]0x1EC3, [char]0x1EE7
                    [System.Windows.Forms.MessageBox]::Show($errMsg, $errTitle, [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning)
                    Start-Process "https://github.com/$repo/releases/latest"
                }
            }
        }
    } catch {}
}

$scriptFilePath = if ($global:vPath) { $global:vPath } elseif ($MyInvocation.MyCommand.Path) { $MyInvocation.MyCommand.Path } else { $PSCommandPath }
Check-VBSPUpdate -currentVer "v2026.10.08" -repo "giaphai/OneClickVBSP-Release" -targetFile $scriptFilePath

$payload = ""

Invoke-VBSPBoot $payload
